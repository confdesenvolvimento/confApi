# ATUAL: cService gera somente tokens. Autenticacao mobile e persistencia pertencem ao Manager.
# Veja docs/ARQUITETURA_TOKENS_E_AUTENTICACAO.md. Nao aplicar migracoes no CSERVICES.
# Entrada publica do app: /api/v2/autenticador-mobile (inclua o contexto WAR na URL do app).
# AUTH_V2_CSERVICE_TOKEN_FILE: sub=confapi, aud=cservice3-internal, scopes v2:access mobile:relay session:introspect.
# Somente AUTH_V2_CSERVICE_URL aponta ao cService3; AUTH_V2_MANAGER_URL aponta ao Manager.
# Integracao somente por API. Nao configurar acesso ao banco CSERVICES neste consumidor.
# Configuração de homologação. Este arquivo não é carregado automaticamente.
# Defina as variáveis no serviço/container. Não grave credenciais reais no repositório.
# O Manager exige suas tabelas AUTH_V2_*; a instalacao em producao depende de autorizacao separada.
AUTH_V2_ENABLED=false
AUTH_V2_ISSUER=
AUTH_V2_JWKS_JSON=
AUTH_V2_MANAGER_URL=https://manager.example.test/manager
AUTH_V2_MANAGER_TOKEN_FILE=
AUTH_V2_RESOURCE_ORIGIN=https://confapi.example.test
AUTH_V2_MOBILE_ROUTES_JSON=[]

